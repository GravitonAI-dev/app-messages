LOG_LEVEL=info

# Obligatorio en el VPS: lo usa el despliegue para recargar el contenido sin
# reiniciar (POST /internal/reload), y tiene que coincidir con el secret
# VPS_RELOAD_TOKEN del repo. Vacío = el endpoint no existe.
RELOAD_TOKEN=

# Puerto del host al que apunta el proxy inverso.
HOST_PORT=3000

# Raíz del clon del que se sirve el contenido, relativa a compose.yaml. Por
# defecto `..`: el clon del VPS, con este server/ dentro. El despliegue lo
# mantiene en el commit desplegado (git reset --hard) y lo monta en /content
# de sólo lectura. Sólo hace falta tocarlo si el contenido está en otro sitio.
# CONTENT_DIR_HOST=..
