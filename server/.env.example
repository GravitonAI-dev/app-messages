LOG_LEVEL=info

# Obligatorio en el VPS: lo usa el despliegue para recargar el contenido sin
# reiniciar (POST /internal/reload), y tiene que coincidir con el secret
# VPS_RELOAD_TOKEN del repo. Vacío = el endpoint no existe.
RELOAD_TOKEN=

# Puerto del host al que apunta el proxy inverso.
HOST_PORT=3000

# Directorio del host con el contenido que se sirve (index.json, codes.json,
# messages/, home/, assets/, preview/, templates/). Lo crea y lo llena el
# despliegue; se monta en /content de sólo lectura. Relativo a compose.yaml.
# CONTENT_DIR_HOST=./content
