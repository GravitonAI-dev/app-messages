# URL pública del servicio (sin barra final): con ella se calculan {{asset_url}} y las imágenes.
PUBLIC_BASE_URL=https://messages.confidentialai.es
LOG_LEVEL=info

# Firebase: sólo para verificar el ID token de la app.
FIREBASE_PROJECT_ID=confgpt-b376c

# billing (Cloud Functions userInfo, getPlans) y validation-telemetry (/api/user-usage/{uid}).
BILLING_URL=https://us-central1-confgpt-b376c.cloudfunctions.net
TELEMETRY_URL=https://validation-telemetry.confidentialai.es
UPSTREAM_TIMEOUT_MS=5000

# Vacío = POST /internal/reload desactivado.
RELOAD_TOKEN=

# Puerto del host al que apunta el proxy inverso.
HOST_PORT=3000
