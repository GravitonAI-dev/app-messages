{
  "name": "app-messages-server",
  "version": "1.0.0",
  "private": true,
  "description": "Microservicio de app-messages: sirve los mensajes y la portada de la app, y los evalúa con los datos de la cuenta",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && CONTENT_DIR=.. node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/"
  },
  "dependencies": {
    "@app-messages/contract": "link:../scripts/core",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "dotenv": "^16.4.0",
    "firebase-admin": "^13.0.0",
    "pino": "^9.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
