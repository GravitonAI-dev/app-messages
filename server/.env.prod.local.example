# app-messages en local, compilado (compose.prod.local.yaml, make up-local).
# Copiar a .env.prod.local.

LOG_LEVEL=debug

# Para recargar el contenido montado sin reiniciar (make reload-local). Cualquier
# valor local; vacío = POST /internal/reload desactivado.
RELOAD_TOKEN=local-reload-token

# Puerto del host: el de la pila local (Gateway Monorepo/docs/local-ecosystem.md).
HOST_PORT=3042
