{
  "schema_version": 1,
  "id": "purchase_success",
  "enabled": true,
  "when": {
    "membership.payment_status": "paid",
    "membership.plan_code": {
      "neq": "free_plan"
    },
    "membership.hours_since_start": {
      "lte": 24
    }
  },
  "title": "Compra completada",
  "size": "md",
  "position": "center",
  "backdrop": "blur",
  "dismissible": true,
  "persistent": false,
  "auto_close": 0,
  "priority": 60,
  "html_file": "purchase_success.html",
  "actions": [
    {
      "label": "Ir al Panel de Usuario",
      "action": "url",
      "url": "https://confidentialai.es/dashboard",
      "variant": "primary"
    }
  ]
}
