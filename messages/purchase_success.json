{
  "schema_version": 1,
  "id": "purchase_success",
  "enabled": true,
  "when": {
    "membership.payment_status": "paid",
    "membership.plan_code": { "neq": "free_plan" },
    "membership.hours_since_start": { "lte": 24 }
  },
  "size": "md",
  "position": "center",
  "backdrop": "blur",
  "dismissible": true,
  "persistent": false,
  "auto_close": 0,
  "priority": 60,
  "html_file": "purchase_success.html"
}
