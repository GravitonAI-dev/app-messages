{
  "schema_version": 1,
  "id": "trial_ending_soon",
  "enabled": true,
  "when": {
    "membership.plan_code": "free_plan",
    "usage.payment_status": { "neq": "expired" },
    "membership.days_left": { "gte": 0, "lte": 2 }
  },
  "size": "sm",
  "position": "bottom-right",
  "backdrop": "none",
  "dismissible": true,
  "persistent": false,
  "auto_close": 10,
  "priority": 20,
  "html_file": "trial_ending_soon.html"
}
